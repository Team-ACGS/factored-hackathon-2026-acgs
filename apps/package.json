{
  "name": "clara-apps",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "pnpm --recursive --workspace-concurrency=1 typecheck",
    "test": "pnpm --recursive --workspace-concurrency=1 --if-present test",
    "build": "pnpm --recursive --workspace-concurrency=1 --if-present build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
